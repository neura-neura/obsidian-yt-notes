{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "1.2.21",
  "default_locale": "en",
  "short_name": "Obsidian YT Notes",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "clipboardWrite",
    "alarms",
    "scripting",
    "system.cpu",
    "system.memory"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-notes-panel": {
      "suggested_key": {
        "default": "Alt+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Open Obsidian YT Notes panel"
    },
    "open-notes-folder": {
      "description": "Open Obsidian YT Notes folder"
    },
    "open-floating-notes-panel": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Open Obsidian YT Notes in floating mode"
    }
  },
  "content_scripts": [
    {
      "all_frames": true,
      "matches": ["<all_urls>"],
      "match_about_blank": true,
      "js": [
        "hover-notes-utils.js",
        "content-script.js",
        "video-hover-button.js",
        "string-utils.js",
        "obsidian-local-fs.js"
      ],
      "css": ["hn-inject.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/cursor-camera.png",
        "assets/icons/hover-notes-icon-white.svg",
        "assets/fonts/atkinson/AtkinsonHyperlegible-Regular.ttf",
        "assets/fonts/atkinson/AtkinsonHyperlegible-Bold.ttf",
        "hn-inject.css",
        "hn-shadow.css",
        "shadcn.css",
        "theme.js",
        "editor.html",
        "editor.css",
        "editor.js",
        "vendor/toastui/toastui-editor.css",
        "vendor/toastui/toastui-editor.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
